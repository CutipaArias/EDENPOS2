<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>EdenPOS</AssemblyName>
    <RootNamespace>EdenPOS</RootNamespace>
    <Version>2.3.1</Version>
    <ApplicationIcon>Assets\EdenPOS.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="devdb\tests\**\*.cs" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Npgsql" Version="8.0.9" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\EdenPOS.ico" />
    <None Update="Assets\supabase-ca.crt" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="Assets\EdenPOS-Login-v2.png" />
    <Content Include="Assets\EdenPOS-Login-v2.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Remove="Assets\Catalog\*.png" />
    <Content Include="Assets\Catalog\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Fotos reales opcionales que reemplazan los íconos (ver Assets\Fotos\LEEME.md). -->
    <None Remove="Assets\Fotos\**" />
    <Content Include="Assets\Fotos\*.jpg;Assets\Fotos\*.jpeg;Assets\Fotos\*.png;Assets\Fotos\*.bmp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
